# Frontend env — copy to `.env.local` for dev. audit_devops F-11.
#
# Anything prefixed with NEXT_PUBLIC_ is baked into the client bundle at
# build time. Anything without the prefix is only available on the server
# side (Server Components, `next start`, `lib/server-api.ts`).

# Where the browser should send /api/* requests — usually the same origin
# in production behind Caddy. Leaving it as `/api/v1` means the axios
# client uses the Next.js rewrite in `next.config.mjs`.
NEXT_PUBLIC_API_URL=/api/v1

# Where the Next.js server should fetch backend data from (Server
# Components, sitemap generation). Inside docker-compose this is the
# internal backend service hostname, locally it points at uvicorn.
BACKEND_INTERNAL_URL=http://localhost:8000

# Optional — only set if you use Google OAuth on the frontend.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
